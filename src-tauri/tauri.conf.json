{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "termCode",
  "version": "0.1.0",
  "identifier": "dev.jorgetorres.termcode",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "termCode",
        "width": 1280,
        "height": 800,
        "minWidth": 520,
        "minHeight": 320,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0f0e0c",
        "trafficLightPosition": {
          "x": 16,
          "y": 19
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
